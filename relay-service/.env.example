# Port Railway/local dev listens on. Railway injects this automatically in
# production -- only needed for local dev.
PORT=3000

# Must exactly match Settings!RELAY_SHARED_SECRET in the Google Sheet.
RELAY_SHARED_SECRET=paste-the-generated-secret-here

# The Apps Script Web App /exec URL (Settings!APPS_SCRIPT_WEB_APP_URL).
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# JSON array, one object per Titan mailbox. "email" must exactly match the
# Email column in the Senders sheet -- that's the join key.
# Titan's standard endpoints (confirm in your Titan control panel):
#   SMTP: smtp.titan.email, port 465 (SSL) or 587 (STARTTLS)
#   IMAP: imap.titan.email, port 993 (SSL)
SENDERS_CONFIG=[{"email":"sales1@example.com","smtpHost":"smtp.titan.email","smtpPort":465,"smtpSecure":true,"smtpUser":"sales1@example.com","smtpPass":"CHANGE_ME","imapHost":"imap.titan.email","imapPort":993,"imapUser":"sales1@example.com","imapPass":"CHANGE_ME"}]

# How often the IMAP poller checks every mailbox for new replies.
POLL_INTERVAL_MINUTES=5

# Extra lookback added to the poll window search so a slow cycle can't miss
# a message that arrived right at the boundary. Keep small -- it only
# widens the (harmless, idempotent) duplicate-report window.
POLL_SAFETY_MARGIN_MINUTES=2

NODE_ENV=development
